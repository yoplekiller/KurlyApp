# Appium server
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Android device
APPIUM_DEVICE_NAME=Android
APPIUM_PLATFORM_VERSION=

# Kurly app
# Fill these values after checking the running app with:
# adb shell dumpsys window | Select-String "mCurrentFocus"
KURLY_APP_PACKAGE=
KURLY_APP_ACTIVITY=

# Test account
# Keep real credentials only in .env. Do not commit .env.
TEST_USER_ID=
TEST_USER_PASSWORD=
WRONG_TEST_USER_ID=wrong@example.com
WRONG_TEST_USER_PASSWORD=wrong-password

# Test data
SEARCH_KEYWORD=우유
NO_RESULT_KEYWORD=xyzxyzxyz검색결과없음123
